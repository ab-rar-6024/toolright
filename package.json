{
  "name": "toolright",
  "version": "0.0.2",
  "description": "Does your agent pick the right tool? Test MCP tool descriptions with real models and keep only the rewrites that help.",
  "type": "module",
  "bin": {
    "toolright": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tool-calling",
    "llm",
    "evaluation",
    "agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ab-rar-6024/toolright.git"
  },
  "homepage": "https://github.com/ab-rar-6024/toolright#readme",
  "bugs": {
    "url": "https://github.com/ab-rar-6024/toolright/issues"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
